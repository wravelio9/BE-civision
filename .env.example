# ============================================================
# Civision Backend - Environment Variables (TEMPLATE)
# Salin file ini jadi ".env" lalu isi nilainya. JANGAN commit ".env".
# ============================================================

# --- Database (Supabase PostgreSQL) ---
# WAJIB pakai Connection Pooler (IPv4), BUKAN host langsung db.<ref>.supabase.co
# Dashboard: Project Settings -> Database -> Connection string -> "Transaction pooler"
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# --- Supabase Storage (upload foto) ---
# Dashboard: Project Settings -> API
SUPABASE_URL="https://<project-ref>.supabase.co"
# service_role key (RAHASIA, hanya untuk server. JANGAN taruh di frontend)
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Nama bucket Storage (buat dulu di dashboard, set Public). Default: media
SUPABASE_BUCKET="media"

# --- Server ---
PORT=3000

# --- AI (opsional) ---
AI_API_KEY="<ai-api-key>"

# --- Region bounds untuk validasi koordinat (opsional, default Indonesia) ---
# REGION_LAT_MIN=-11.5
# REGION_LAT_MAX=6.5
# REGION_LON_MIN=94.5
# REGION_LON_MAX=141.5
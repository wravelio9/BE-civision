# Koneksi database Supabase (PostgreSQL).
# Ambil dari: Supabase Dashboard > Project Settings > Database > Connection string (URI).
# Gunakan connection pooler (port 6543) untuk aplikasi, atau direct (5432) untuk migrasi.
# Format: postgresql://USER:PASSWORD@HOST:PORT/postgres
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xxx.pooler.supabase.com:6543/postgres"
PORT=3000
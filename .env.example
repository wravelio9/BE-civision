# ── Database (wajib) ─────────────────────────────────────────────
# Koneksi database Supabase (PostgreSQL).
# Ambil dari: Supabase Dashboard > Project Settings > Database > Connection string (URI).
# Gunakan connection pooler (port 6543) untuk aplikasi, atau direct (5432) untuk migrasi.
# Format: postgresql://USER:PASSWORD@HOST:PORT/postgres
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xxx.pooler.supabase.com:6543/postgres"

# ── Server ───────────────────────────────────────────────────────
# Port HTTP backend.
PORT=3000

# ── Service AI ───────────────────────────────────────────────────
# URL service AI (FastAPI/YOLO). Trailing slash otomatis dibersihkan.
AI_SERVICE_URL="http://localhost:8000"

# ── Deteksi ──────────────────────────────────────────────────────
# Confidence threshold default untuk deteksi (0.0 - 1.0).
DEFAULT_CONF=0.5
# Batas ukuran upload video dalam MB.
MAX_VIDEO_MB=200

# ── Geofence EXIF (batas wilayah valid untuk koordinat foto) ─────
# Default meng-cover wilayah Indonesia.
REGION_LAT_MIN=-11.5
REGION_LAT_MAX=6.5
REGION_LON_MIN=94.5
REGION_LON_MAX=141.5
